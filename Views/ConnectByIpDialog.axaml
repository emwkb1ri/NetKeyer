<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetKeyer.Views.ConnectByIpDialog"
    Title="NetKeyer+Remote - Connect by IP Address"
        Width="420" Height="320"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="false">

    <Grid Margin="15" RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Connect by IP Address"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock Text="Connect directly to a radio without network discovery."
                       FontSize="12"
                       Foreground="Gray"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Body -->
        <Border Grid.Row="1"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="12"
                CornerRadius="3">
            <StackPanel Spacing="10">

                <!-- Phase 1: IP entry -->
                <StackPanel x:Name="IpInputPanel" Spacing="6">
                    <TextBlock Text="Radio IP Address:" FontWeight="SemiBold" FontSize="13"/>
                    <TextBox x:Name="IpAddressTextBox"
                             Watermark="e.g. 192.168.1.100"
                             Width="300"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Phase 2: Station selection (hidden until connected) -->
                <StackPanel x:Name="ClientSelectionPanel" IsVisible="False" Spacing="6">
                    <TextBlock Text="Select a station:" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="SearchingText"
                               Text="Searching for stations..."
                               Foreground="Gray"
                               FontSize="12"/>
                    <ListBox x:Name="ClientListBox"
                             Height="110"
                             SelectionMode="Single"/>
                </StackPanel>

                <!-- Status / error -->
                <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="Gray"/>
                <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="Red" IsVisible="False" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" IsVisible="False" Height="4"/>

            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    Padding="6"
                    Click="CancelButton_Click"/>
            <Button x:Name="ActionButton"
                    Content="Connect"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    Padding="6"
                    IsDefault="True"
                    Click="ActionButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
